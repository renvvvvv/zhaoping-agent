# 飞书多维表格API配置
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_BASE_ID=your_base_id_here
FEISHU_TABLE_ID=your_table_id_here

# 虚拟邮箱配置 (使用 ethereal.email 或其他IMAP邮箱)
EMAIL_IMAP_SERVER=imap.ethereal.email
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your_ethereal_email@ethereal.email
EMAIL_PASSWORD=your_ethereal_password

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
EMAIL_POLL_INTERVAL=60

# 简历存储配置
RESUME_UPLOAD_PATH=./uploads/resumes
